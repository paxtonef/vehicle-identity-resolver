# Vehicle Identity Resolver — environment configuration
# Copy this file to .env and adjust values as needed.
# No real secrets are required for local/dev use — all providers are in-memory stubs.

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
VIR_LOG_LEVEL=INFO

# Default locale used when a request omits one
VIR_DEFAULT_LOCALE=fr-FR

# Timeout (ms) applied to external provider calls (not used by the in-memory stub adapters)
VIR_PROVIDER_TIMEOUT_MS=5000

# API key for a real external vehicle-data provider, if/when one is wired in.
# Not required for v0.1 (stub adapters need no credentials). Leave blank for local dev.
VIR_PROVIDER_API_KEY=

# Whether to persist the raw provider payload alongside the normalized result.
# Keep false unless you have a retention/compliance reason to store it (see VIR-INV policies).
VIR_STORE_RAW_PROVIDER_PAYLOAD=false
